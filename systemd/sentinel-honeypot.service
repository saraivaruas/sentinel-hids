[Unit]
Description=Sentinel: puertos señuelo (sin privilegios)
After=network.target

[Service]
Type=simple
User=sentinel
Group=sentinel
Environment=PYTHONPATH=/opt/sentinel PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m sentinel honeypot
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
ReadWritePaths=/var/log/sentinel/decoy
LimitNOFILE=1024
MemoryMax=128M

[Install]
WantedBy=multi-user.target
