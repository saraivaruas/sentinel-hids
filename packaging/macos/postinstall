#!/bin/bash
# Lo ejecuta el Instalador de macOS como administrador.
set -e
AQUI="$(cd "$(dirname "$0")" && pwd)"
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
# quien está usando el equipo recibirá los avisos y el icono de la barra
QUIEN="$(stat -f %Su /dev/console 2>/dev/null || true)"
[ "$QUIEN" = root ] && QUIEN=""
exec env SUDO_USER="$QUIEN" "$AQUI/sentinel-src/install-mac.sh"
