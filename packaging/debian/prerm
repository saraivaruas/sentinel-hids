#!/bin/sh
set -e
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
  if [ -d /run/systemd/system ]; then
    systemctl disable --now sentinel-monitor.service sentinel-honeypot.service sentinel-scan.timer sentinel-report.timer 2>/dev/null || true
  fi
fi
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
  ufw status numbered 2>/dev/null | grep -q sentinel-senuelo && for p in $(ufw status numbered | grep sentinel-senuelo | awk -F'[][]' '{print $2}' | sort -rn); do yes | ufw delete "$p" >/dev/null; done || true
fi
exit 0
